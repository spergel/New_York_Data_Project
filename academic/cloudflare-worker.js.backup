  {
    "id": "evt_columbia_004bb49d",
    "event_id": "evt_columbia_004bb49d",
    "name": "Playing for the Planet",
    "type": "Academic",
    "description": "<p>Every sport is played on nature&rsquo;s stage. As climate change and habitat destruction threaten biodiversity, the sports industry must step up as a key player in conservation. This panel will bring together experts to explore how sports organizations, teams, leagues, venues, and athletes are working to restore natural habitats, promote sustainable land use, and reduce their ecological impact.</p> <p>Join us during Climate Week NYC to discover how sports can inspire action and drive lasti...",
    "start_date": "2025-09-22",
    "end_date": "2025-09-23",
    "source": "columbia_",
    "source_group": "columbia_general",
    "source_url": "https://events.columbia.edu/cal/event/eventView.do?b=de&calPath=%2Fpublic%2Fcals%2FMainCal&guid=CAL-00bbdb7c-97bfe6ab-0197-c1df5829-00005c98events%40columbia.edu&recurrenceId=",
    "source_name": "Columbia University",
