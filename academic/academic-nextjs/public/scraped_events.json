    {
      "id": "evt_columbia_b3bc7723",
      "name": "The Power Shift",
      "type": "Academic",
      "location_id": "loc_columbia_main",
      "community_id": "com_columbia_general",
      "description": "&lt;p&gt;Since World War II, research universities have been deeply shaped by government funding and influence. But today, the balance is shifting: Silicon Valley is emerging as a new epicenter of research, sometimes displacing and sometimes bankrolling academic work.&lt;/p&gt;\n&lt;p&gt;This panel, &amp;quot;&lt;strong&gt;The Power Shift: Rethinking the University-Government-Big Tech Relationship&lt;/strong&gt;,&amp;quot; will&amp;nbsp;explore how universities are confronting these competing forces of government and industry, and ask what it will take to preserve academic independence in a rapidly changing landscape.&lt;/p&gt;\n&lt;p&gt;&lt;strong&gt;Panelists:&amp;nbsp;&lt;/strong&gt;&lt;/p&gt;\n&lt;ul&gt;\n&lt;li&gt;&lt;a href=\"https://provost.columbia.edu/people/angela-v-olinto\" target=\"_blank\"&gt;&lt;strong&gt;Angela Olinto&lt;/strong&gt;&lt;/a&gt;,&amp;nbsp;Professor of Astronomy and of Physics and Provost, Columbia University&lt;/li&gt;\n&lt;li&gt;&lt;a href=\"https://www.ft.com/stream/b359c1e1-f7ed-4239-816c-1720f99df8b4\" target=\"_blank\"&gt;&lt;strong&gt;Andrew Jack&lt;/strong&gt;&lt;/a&gt;, Global Education Editor, Financial Times&lt;/li&gt;\n&lt;li&gt;&lt;strong&gt;&lt;a href=\"https://www.schmidtsciences.org/person/mike-belinsky/\" target=\"_blank\"&gt;Michael Belinsky&lt;/a&gt;&lt;/strong&gt;,&amp;nbsp;Director in the AI Institute, Schmidt Sciences&lt;/li&gt;\n&lt;/ul&gt;\n&lt;p&gt;&lt;strong&gt;Moderator:&amp;nbsp;&lt;/strong&gt;&lt;/p&gt;\n&lt;ul&gt;\n&lt;li&gt;&lt;a href=\"https://polisci.barnard.edu/profiles/alexander-cooley\" target=\"_blank\"&gt;&lt;strong&gt;Alexander Cooley&lt;/strong&gt;&lt;/a&gt;,&lt;strong&gt;&amp;nbsp;&lt;/strong&gt;Claire Tow&amp;nbsp;Professor of Political Science, Barnard College&lt;/li&gt;\n&lt;/ul&gt;\n&lt;p&gt;This event belongs to a new&amp;nbsp;interdisciplinary series,&amp;nbsp;&lt;strong&gt;&lt;em&gt;The Future of Academic Freedom: Universities and the Erosion of Democratic Norms&lt;/em&gt;&lt;/strong&gt;,&amp;nbsp;organized by&amp;nbsp;&lt;a href=\"https://www.sipa.columbia.edu/sipa-education/masters-programs/concentrations/technology-policy-and-innovation\"&gt;SIPA&amp;rsquo;s Technology, Policy &amp;amp; Innovation concentration&lt;/a&gt;, &lt;a href=\"https://worldprojects.columbia.edu/\"&gt;Columbia World Projects&lt;/a&gt;, the &lt;a href=\"https://cgt.columbia.edu/\"&gt;Committee on Global Thought&lt;/a&gt;, and the &lt;a href=\"https://ipdcolumbia.org/\"&gt;Initiative for Policy Dialogue&lt;/a&gt;.&lt;/p&gt;\n&lt;p&gt;These conversations are&amp;nbsp;free and open to the public. Please register in advance to attend.&amp;nbsp;&lt;/p&gt;",
      "start_date": "2025-12-02T22:30:00+00:00",
      "end_date": "2025-12-02T23:30:00+00:00",
      "category": [
        "EDUCATION",
        "SCIENCE",
        "SOCIAL",
        "TECH"
      ],
