    {
      "id": "evt_columbia_70e3f135",
      "name": "Reflections from Bel&eacute;m: Columbia at COP30",
      "type": "Academic",
      "location_id": "loc_columbia_main",
      "community_id": "com_columbia_general",
      "description": "&lt;p&gt;As the world turns from negotiation to implementation following COP30 in Bel&amp;eacute;m, the Columbia Climate School invites you to join the final installment of the &lt;em&gt;Countdown to COP30&lt;/em&gt; series: &lt;strong&gt;Reflections from Bel&amp;eacute;m: Columbia at COP30&lt;/strong&gt;.&lt;/p&gt;\n&lt;p&gt;This closing session will feature firsthand insights from Columbia faculty and student delegates who attended COP30, highlighting key takeaways, breakthrough moments, and the road ahead. The discussion will explore what was achieved in Bel&amp;eacute;m, how Columbia contributed, and how the university will continue to support global climate implementation and accountability efforts moving forward.&lt;/p&gt;\n&lt;p&gt;Moderated by &lt;strong&gt;Jeffrey Schlegelmilch-&amp;nbsp;&lt;/strong&gt;Associate Professor of Professional Practice in the Faculty of Climate, Director, National Center for Disaster Preparedness (NCDP), Director of Executive Education and Non-Degree Programs, Executive Education&lt;/p&gt;\n&lt;p&gt;Panelist&lt;/p&gt;\n&lt;ul&gt;\n&lt;li&gt;\n&lt;p&gt;&lt;strong&gt;Sheila Foster&lt;/strong&gt;- Professor of Climate, Columbia Climate School&lt;/p&gt;\n&lt;/li&gt;\n&lt;li&gt;\n&lt;p&gt;&lt;strong&gt;Amy Campbell &lt;/strong&gt;- Executive Office of the UN Secretary General (Adaptation Workstream), Former UK Climate Negotiator and Climate School Alumni&lt;/p&gt;\n&lt;/li&gt;\n&lt;li&gt;\n&lt;p&gt;&lt;strong&gt;Karenna Gore&lt;/strong&gt;- Executive Director, Center for Earth Ethics &amp;amp; Teaching Professor of Practice of Earth Ethics&lt;/p&gt;\n&lt;/li&gt;\n&lt;/ul&gt;\n&lt;p&gt;Reception to follow from 5:30 PM to 6:30 PM next door in Room 316&lt;/p&gt;",
      "start_date": "2025-12-01T21:30:00+00:00",
      "end_date": "2025-12-01T22:30:00+00:00",
