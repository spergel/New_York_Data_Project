    {
      "id": "evt_columbia_6ecc6191",
      "name": "Digital Innovation in Reducing Fashion Waste - A Panel Discussion",
      "type": "Academic",
      "location_id": "loc_columbia_sipa",
      "community_id": "com_columbia_general",
      "description": "&lt;p&gt;This panel discussion, cohosted by Impact Fashion and Fashion, Energy and Climate Network of Columbia Climate School, explores how &lt;strong&gt;digital innovation is transforming the fashion industry&amp;rsquo;s approach to waste reduction and circularity&lt;/strong&gt;. Featuring &lt;strong&gt;industry experts and sustainability leaders&lt;/strong&gt;, the event will highlight emerging technologies that help minimize material waste and extend product lifecycles.&lt;/p&gt;\n&lt;p&gt;The session will include a &lt;strong&gt;moderated panel conversation&lt;/strong&gt;, followed by an &lt;strong&gt;interactive Q&amp;amp;A&lt;/strong&gt; with the audience.&amp;nbsp;&lt;/p&gt;\n&lt;p&gt;Speakers:&lt;/p&gt;\n&lt;p&gt;- Tatee Sakr, Professor, Parsons School of Design&lt;/p&gt;\n&lt;p&gt;- Evelyn Mora,&amp;nbsp;Founder, &lt;a href=\"https://www.vlge.com/\" target=\"_blank\"&gt;VLGE&lt;/a&gt;&lt;/p&gt;\n&lt;p&gt;- Nancy Rhodes,&amp;nbsp;Founder and CEO, &lt;a href=\"https://www.alternew.com/\" target=\"_blank\"&gt;Alternew&lt;/a&gt;&lt;/p&gt;\n&lt;p&gt;- Sally Qiu (Moderator), Senior Research Associate, Center on Global Energy Policy; Co-director of Fashion, Energy, and Climate Network, Columbia Climate School&lt;/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;/p&gt;",
      "start_date": "2025-12-02T22:00:00+00:00",
