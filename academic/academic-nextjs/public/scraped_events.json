    {
      "id": "evt_columbia_3acfa654",
      "name": "Documenting Human Rights Harms:The UN Mandate on Truth &amp; Reparation",
      "type": "Academic",
      "location_id": "loc_columbia_law",
      "community_id": "com_columbia_general",
      "description": "&lt;p&gt;&lt;strong&gt;Documenting Human Rights Harms, Advancing Justice:&amp;nbsp;The UN Mandate on Truth and Reparation&lt;/strong&gt;&lt;/p&gt;\n&lt;p&gt;Join Columbia Law School Human Rights Institute for a special conversation with&amp;nbsp;&lt;strong&gt;Professor Bernard Duhaime&lt;/strong&gt;, United Nations Special Rapporteur on the promotion of truth, justice, reparation, and guarantees of non-recurrence. The event will explore the role of the UN mandate in addressing human rights harms worldwide, advancing accountability, and strengthening survivor-centered approaches to truth and reparation. The discussion will examine global trends in documentation, gaps in protection, and emerging strategies to prevent recurrence.&lt;/p&gt;\n&lt;p&gt;&lt;strong&gt;Speaker:&amp;nbsp;&lt;/strong&gt;Professor Bernard Duhaime, UN Special Rapporteur; Professor of International Law, Universit&amp;eacute; du Qu&amp;eacute;bec &amp;agrave; Montr&amp;eacute;al; Senior Fellow, Human Rights Institute&lt;/p&gt;\n&lt;ul&gt;\n&lt;li&gt;&lt;strong&gt;When:&amp;nbsp;&lt;/strong&gt;Tuesday, December 2, 2025 | 12:10&amp;ndash;1:10 PM&lt;/li&gt;\n&lt;li&gt;&lt;strong&gt;Where:&amp;nbsp; &amp;nbsp;&lt;/strong&gt;Columbia Law School | JG 107&lt;/li&gt;\n&lt;/ul&gt;\n&lt;p&gt;Lunch will be served.&lt;/p&gt;\n&lt;p&gt;Please register below:&lt;/p&gt;",
      "start_date": "2025-12-02T17:10:00+00:00",
      "end_date": "2025-12-02T18:10:00+00:00",
      "category": [
        "EDUCATION",
