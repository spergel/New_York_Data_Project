    {
      "id": "evt_columbia_1e9dd9f3",
      "name": "Hematological Malignancies Seminar Series: Peter van Galen, PhD",
      "type": "Seminar",
      "location_id": "loc_columbia_main",
      "community_id": "com_columbia_general",
      "description": "&lt;p&gt;&lt;strong&gt;Speaker:&amp;nbsp;&lt;a href=\"https://www.hsci.harvard.edu/people/peter-van-galen-phd\" target=\"_blank\"&gt;Peter van Galen, PhD&lt;/a&gt;&lt;/strong&gt;,&amp;nbsp;Associate Molecular Biologist, Harvard University&lt;/p&gt;\n&lt;p&gt;&lt;em&gt;Hosted by Sergei Doulatov, PhD, Associate Professor of Physiology and Cellular Biophysics&amp;nbsp;at CUIMC.&lt;/em&gt;&lt;/p&gt;\n&lt;p&gt;This event is sponsored by the Herbert Irving Comprehensive Cancer Center&amp;#39;s (HICCC)&amp;nbsp;&lt;a href=\"https://www.cancer.columbia.edu/research/researchers/edward-p-evans-center-myelodysplastic-syndromes-mds\" target=\"_blank\"&gt;Edward P. Evans Center for Myelodysplastic Syndromes (MDS)&lt;/a&gt;&amp;nbsp;at Columbia University, established to&amp;nbsp;foster an all-encompassing approach in studying MDS&amp;nbsp;giving us&amp;nbsp;molecular, cellular genetic and epigenetic insights to develop and test innovative therapies.&lt;/p&gt;",
