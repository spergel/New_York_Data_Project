    {
      "id": "evt_columbia_a8e1be7e",
      "name": "Contact Microphone Workshop",
      "type": "Workshop",
      "location_id": "loc_columbia_main",
      "community_id": "com_columbia_general",
      "description": "&lt;p&gt;The last workshop of the semester will be an easy going session where we will learn how to solder our own contact mics!&amp;nbsp;A piezo contact mic is a type of microphone that picks up vibrations directly from solid objects by using a piezoelectric effect sensor. Unlike a traditional microphone that captures sound waves in the air, a contact mic is placed directly onto a surface, such as an instrument or a wall, and records the sounds produced by its vibrations. No previous experience is required.&amp;nbsp;&lt;/p&gt;\n&lt;p&gt;&lt;strong&gt;NOTE: &lt;/strong&gt;This session will take place in &lt;a href=\"https://maps.app.goo.gl/SspALRxTjdsUDT897\"&gt;Prentis Hall, 632 W.125th St&lt;/a&gt;. Access details will be provided after registration.&lt;/p&gt;\n&lt;p&gt;Instructor:&amp;nbsp;&amp;nbsp;&lt;a href=\"https://asalaus.com/\" target=\"_blank\"&gt;&amp;Aacute;sa &amp;Oacute;lafsd&amp;oacute;ttir&lt;/a&gt;&amp;nbsp;(MFA Sound Art program; Libraries Digital Music Intern)&lt;/p&gt;\n&lt;p&gt;Info on further&amp;nbsp;upcoming&amp;nbsp;workshops in the Music Technology series, including registration links, is available here:&amp;nbsp;&amp;nbsp;&amp;nbsp;&lt;strong&gt;&lt;a href=\"http://bit.ly/MusicTechWorkhopsF25\" target=\"_blank\"&gt;bit.ly/MusicTechWorkhopsF25&lt;/a&gt;&lt;/strong&gt;&lt;/p&gt;\n&lt;p&gt;Questions? Please email&amp;nbsp;&lt;a href=\"mailto:musiclibrary@columbia.edu\" target=\"_blank\"&gt;musiclibrary@columbia.edu&lt;/a&gt;&lt;/p&gt;",
      "start_date": "2025-12-05T19:00:00+00:00",
